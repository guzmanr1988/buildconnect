# Supabase
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe (Phase 1+) — CLIENT side
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx

# Stripe Connect Express — SERVER side (Supabase Edge Function secrets)
# Set via: supabase secrets set STRIPE_SECRET_KEY=sk_test_... STRIPE_WEBHOOK_SECRET=whsec_... ...
# NEVER commit real values. NEVER write secrets to .env files in the repo.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# STRIPE_APP_URL=https://buildc.net   # used in account-link refresh/return URLs

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your-key-here
